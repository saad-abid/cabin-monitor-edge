*.pt
*.pth
*.onnx
*.engine

# --- Ultralytics run outputs ---
runs/

# --- Results: keep CSVs, charts and analysis; ignore annotated images/videos ---
results/detections/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
